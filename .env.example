# Sin estas variables se muestra una vista inicial vacía, sin acceso a datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Conexión SQL del servidor (rol electoral_app de solo lectura en Sprint 1).
DATABASE_URL=
# Conexión administrativa, solo para migraciones y semillas; no usar en navegador.
DATABASE_MIGRATION_URL=
APP_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001
APP_CANTON_ID=20000000-0000-4000-8000-000000000001
APP_EVENT_ID=30000000-0000-4000-8000-000000000001
# Confirmación explícita para cargar SOLO datos sintéticos en un entorno de demo.
ALLOW_DEMO_SEED=false
