# Sin estas variables se muestra una vista inicial vacía, sin acceso a datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Conexión SQL del servidor (rol electoral_app de solo lectura en Sprint 1).
DATABASE_URL=
# Conexión administrativa, solo para migraciones y semillas; no usar en navegador.
DATABASE_MIGRATION_URL=
APP_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001
APP_CANTON_ID=20000000-0000-4000-8000-000000000001
APP_EVENT_ID=30000000-0000-4000-8000-000000000001
# Confirmación explícita para cargar SOLO datos sintéticos en un entorno de demo.
ALLOW_DEMO_SEED=false
# Carga explícita de 7 provincias/21 cantones reales de referencia en un evento demo.
ALLOW_TERRITORY_TEST_SEED=false

# Solo servidor: permite crear cuentas autorizadas en Supabase Auth.
SUPABASE_SECRET_KEY=
# Secreto aleatorio de al menos 32 caracteres para HMAC de cédulas/códigos.
# Conservar estable y respaldar; cambiarlo impide reconocer cédulas ya autorizadas.
# También firma formularios/cookie de transporte público; mínimo 32 caracteres.
AUTH_IDENTIFIER_SECRET=
# Origen público de esta instalación, sin ruta; HTTPS salvo desarrollo local.
# Debe autorizarse su /auth/callback en Supabase Auth para recuperación PKCE.
APP_SITE_URL=http://127.0.0.1:3000

# Solo servidor: token de consulta de nombres de Soporte Real (solicitar al proveedor).
SOPORTEREAL_API_KEY=

# Integración aplazada; no se realizan consultas externas mientras sea false.
SOPORTEREAL_ENABLED=false
